{
  "name": "loose-orphans-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "git -C .. rev-parse --git-dir >/dev/null 2>&1 && git -C .. config core.hooksPath .githooks || true",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run --silent typecheck && npm run --silent lint && npm run --silent format:check && npm run --silent test && npm run --silent test:defaults",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src tests",
    "format": "prettier --write src tests index.html vite.config.ts",
    "format:check": "prettier --check src tests index.html vite.config.ts",
    "test": "vitest run",
    "test:defaults": "CAST_DEFAULTS=1 vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "smol-toml": "^1.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
